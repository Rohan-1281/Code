#include <bits/stdc++.h>
using namespace std;
const long long M = 1e9 + 7;

int main() {
ios::sync_with_stdio(false);
cin.tie(nullptr);

    int n;
    cin >> n;

    vector<int> A(n);
    for (int i = 0; i < n; i++) {
        cin >> A[i];
    }

    int st = 0, end = n - 1;
    while (st <= end) {
        int mid = st + (end - st) / 2;

        if (mid == 0 && A[0] != A[1]) {
            cout << A[mid];
            return 0;
        }
        if (mid == n - 1 && A[n - 1] != A[n - 2]) {
            cout << A[mid];
            return 0;
        }

        if (A[mid - 1] != A[mid] && A[mid] != A[mid + 1]) {
            cout << A[mid];
            return 0;
        }

        if (mid % 2 == 0) { // even
            if (A[mid - 1] == A[mid]) { // left
                end = mid - 1;
            } else { // right
                st = mid + 1;
            }
        } else { // odd
            if (A[mid - 1] == A[mid]) { // right
                st = mid + 1;
            } else { // left
                end = mid - 1;
            }
        }
    }

    return 0;
}
