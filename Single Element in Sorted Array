#include <bits/stdc++.h>
using namespace std;
const long long M = 1e9 + 7;

int main() {
ios::sync_with_stdio(false);
cin.tie(nullptr);

    int n;
    cin >> n;
    vector<int> A(n);
    for (int i = 0; i < n; i++) {
        cin >> A[i];
    }

    int st = 0, end = n - 1;
    while (st <= end) {
        int mid = st + (end - st) / 2;

        // Check boundaries safely
        if (mid == 0) {
            if (A[0] != A[1]) {
                cout << A[0];
                return 0;
            }
        } else if (mid == n - 1) {
            if (A[n - 1] != A[n - 2]) {
                cout << A[n - 1];
                return 0;
            }
        } else if (A[mid] != A[mid - 1] && A[mid] != A[mid + 1]) {
            cout << A[mid];
            return 0;
        }

        // Binary search logic
        if (mid % 2 == 0) {
            if (A[mid] == A[mid + 1]) {
                st = mid + 2;
            } else {
                end = mid - 1;
            }
        } else {
            if (A[mid] == A[mid - 1]) {
                st = mid + 1;
            } else {
                end = mid - 1;
            }
        }
    }

    return 0;
}
