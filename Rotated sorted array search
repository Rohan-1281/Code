#include <bits/stdc++.h>
using namespace std;
const long long M = 1e9 + 7;

int main() {
ios::sync_with_stdio(false);
cin.tie(nullptr);

   int n;
    cin >> n;

    vector<int> A(n);
    for(int i = 0; i < n; i++){
        cin >> A[i];
    }

    int tar;
    cin >> tar;

    int st = 0, end = n - 1;
    int ans = -1;

    while(st <= end){
        int mid = st + (end - st) / 2;

        if(A[mid] == tar){
            ans = mid;
            break;
        }

        // left part sorted
        if(A[st] <= A[mid]){
            if(A[st] <= tar && tar < A[mid]){
                end = mid - 1;
            } else {
                st = mid + 1;
            }
        }
        // right part sorted
        else{
            if(A[mid] < tar && tar <= A[end]){
                st = mid + 1;
            } else {
                end = mid - 1;
            }
        }
    }

    cout << ans+1 << endl;
    return 0;
}
